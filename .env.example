# Database (Railway PostgreSQL or local)
DATABASE_URL="postgresql://user:pass@host:5432/acerteamosca"

# WebSocket servers — dev (servidores individuais)
NEXT_PUBLIC_WS_URL="ws://localhost:3002"
NEXT_PUBLIC_WS_SHIPS_URL="ws://localhost:3003"
NEXT_PUBLIC_WS_MEMORY_URL="ws://localhost:3004"
NEXT_PUBLIC_WS_2048_URL="ws://localhost:3005"
NEXT_PUBLIC_WS_BATALHA_URL="ws://localhost:3006"

# WebSocket servers — produção Railway (servidor unificado ws-unified.js)
# Configurar estas variáveis no serviço Next.js do Railway:
# NEXT_PUBLIC_WS_URL="wss://ws.acerteamosca.com.br/pong"
# NEXT_PUBLIC_WS_SHIPS_URL="wss://ws.acerteamosca.com.br/ships"
# NEXT_PUBLIC_WS_MEMORY_URL="wss://ws.acerteamosca.com.br/memory"
# NEXT_PUBLIC_WS_2048_URL="wss://ws.acerteamosca.com.br/2048"
# NEXT_PUBLIC_WS_BATALHA_URL="wss://ws.acerteamosca.com.br/batalha-naval"

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=""

# Google AdSense (optional) — formato ca-pub-XXXXXXXXXXXXXXXX (o publisher do ads.txt)
NEXT_PUBLIC_ADSENSE_ID=""

# AdSense — unidades manuais (opcionais). SÓ o ID numérico do bloco, como o
# painel do AdSense gera (ex.: 1234567890). Vazio ou não numérico = a unidade
# não renderiza e ficam só os Anúncios Automáticos.
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=""
NEXT_PUBLIC_ADSENSE_SLOT_HOME_BOTTOM=""
NEXT_PUBLIC_ADSENSE_SLOT_GAME_FOOTER=""
